# VoxLibre environment — copy to .env and fill in secrets
# Required for any database-backed run (local dev or docker compose):
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voxlibre?schema=public"

# Optional local voice sidecar (FastAPI + Kokoro/faster-whisper). Leave blank to use
# exact-match fallback for typed answer checking. When running via compose with
# the voice profile, set to http://voice:8000
VOXLIBRE_VOICE_SERVICE_URL="http://localhost:8000"

# Auth — passkey sessions (jose ES256). Provide either inline PEM or paths to
# operator-managed key files on disk. At least one pair is required in production;
# when unset the app uses an ephemeral in-memory keypair and warns at startup.
AUTH_JWT_PRIVATE_KEY=""
AUTH_JWT_PUBLIC_KEY=""
# File-path alternatives (preferred for production / compose secrets):
AUTH_JWT_PRIVATE_KEY_PATH=""
AUTH_JWT_PUBLIC_KEY_PATH=""

# WebAuthn — must match the origin serving the app
WEBAUTHN_RP_ID="localhost"
WEBAUTHN_RP_NAME="VoxLibre"
WEBAUTHN_ORIGIN="http://localhost:3000"
