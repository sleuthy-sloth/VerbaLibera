{
  "name": "verbalibera",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop-dist/main.js",
  "scripts": {
    "desktop:compile": "tsc -p desktop/tsconfig.json && cp desktop/ui/*.html desktop-dist/ui/ && esbuild desktop/ui/setup.ts --bundle --format=iife --outfile=desktop-dist/ui/setup.js --log-level=error && esbuild desktop/ui/recovery.ts --bundle --format=iife --outfile=desktop-dist/ui/recovery.js --log-level=error && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=desktop-dist/preload.js --log-level=error && echo '{\"type\":\"commonjs\"}' > desktop-dist/package.json",
    "desktop:stage-next": "tsx scripts/desktop/stage-next.ts",
    "electron:dev": "npm run desktop:compile && electron .",
    "electron:package": "electron-forge package --arch=arm64",
    "electron:make": "electron-forge make --arch=arm64",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "content:validate": "tsx scripts/content.ts validate",
    "content:stats": "tsx scripts/content.ts stats",
    "content:coverage": "tsx scripts/content.ts coverage",
    "content:audio-check": "tsx scripts/content.ts audio-check",
    "content:duplicates": "tsx scripts/content.ts duplicates",
    "content:build": "tsx scripts/content.ts build",
    "prebuild": "npm run content:build",
    "predev": "npm run content:build",
    "test:e2e:webkit": "playwright test --config playwright.mobile.config.ts",
    "portable:build": "tsx scripts/portable/build.ts",
    "portable:verify": "tsx scripts/portable/verify.ts",
    "test:e2e:portable": "npm run portable:build && playwright test --config playwright.portable.config.ts",
    "postgres:prepare": "bash scripts/desktop/prepare-postgres.sh",
    "postgres:verify": "tsx scripts/desktop/verify-postgres.ts",
    "electron:verify": "tsx scripts/desktop/verify-artifact.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@tanstack/react-query": "^5.102.8",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "electron": "44.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "fake-indexeddb": "6.2.5",
    "jest-axe": "^9.0.0",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
