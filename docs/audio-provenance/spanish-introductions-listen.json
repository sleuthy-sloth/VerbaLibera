    {
      "kind": "speech",
      "language": "en",
      "voice": "af_heart",
      "text": "Someone hands you your drink. Thank the person with the expression you just heard. No drink name is needed in this response. Think about its purpose in the exchange: the request came before receiving the drink, and this response acknowledges the help afterward.",
      "text_sha256": "f9e015b44fceb2c662a8a09f675f75124d01ffd021d3debd5511fd32a5569c1f",
