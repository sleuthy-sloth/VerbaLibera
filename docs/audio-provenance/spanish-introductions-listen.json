    {
      "kind": "speech",
      "language": "es",
      "voice": "ef_dora",
      "text": "Hola. Quisiera un té, por favor. Gracias.",
      "text_sha256": "0ef892747936e8f2776cc8122fb1c714fcc132a205b9c3eb6a95711cdc0962f1",
