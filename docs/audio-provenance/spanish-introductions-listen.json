      "voice": "ef_dora",
      "text": "Hola. Quisiera un café, por favor. Gracias.",
      "text_sha256": "c6d28b427bee115750812aee1452fd872044234e3c17d5df91554eb7e6b246d3",
      "audio_sha256": "99479d6965975908e212a28e76d3b7e9918509236da5e1129396c00c55d5480d",
      "cacheFile": "4b27f7af9b9f05713a5e381105465e0ff9137de1dda7c4d7204ea0970a14ef1d.wav",
      "durationS": 2.775
    },
    {
      "kind": "silence",
