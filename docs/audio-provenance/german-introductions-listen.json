    {
      "kind": "speech",
      "language": "de",
      "voice": "de_DE-thorsten-medium",
      "text": "Hallo. Ich möchte einen Tee, bitte. Danke.",
      "text_sha256": "bb5f101b5100b17c489bdf296a22be003ff8bc9534bae1476ddb11002246ba2e",
      "audio_sha256": "9bd1c27a780efca25eacba47a6a5138cb65ac6310f5bbdcda0dfdc7c275b8300",
