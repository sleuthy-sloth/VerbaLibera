    {
      "kind": "speech",
      "language": "en",
      "voice": "af_heart",
      "text": "Keep the greeting and thank you, but make the full polite request for tea. Use I would like, the tea block, and please. Build your three contributions, then listen for what changed in the model.",
      "text_sha256": "c88ee212e9e9d0c2542de0359b8b6e504ab3c8f29f2a14853dd12379022b3bda",
